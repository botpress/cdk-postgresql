{
  "name": "@botpress/cdk-postgresql",
  "version": "3.1.0",
  "description": "Postgresql constructs for AWS CDK",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "author": {
    "name": "Botpress",
    "url": "https://github.com/botpress"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/botpress/cdk-postgresql.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "pnpm exec tsdown",
    "watch": "pnpm exec tsdown -w",
    "check": "pnpm run check:type",
    "check:type": "pnpm exec tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "pnpm run build && pnpm exec vitest --run --project=unit",
    "test:integration": "pnpm run build && pnpm exec vitest --run --project=integration",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.239.0",
    "constructs": "^10.3.0"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1116.0",
    "pg": "8.23.0",
    "verror": "^1.10.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "22.13.14",
    "@types/ms": "^2.1.0",
    "@types/pg": "8.23.0",
    "@types/verror": "^1.10.11",
    "aws-cdk-lib": "^2.266.0",
    "constructs": "^10.8.1",
    "eslint": "6.2.0",
    "ms": "^2.1.3",
    "testcontainers": "^12.1.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
